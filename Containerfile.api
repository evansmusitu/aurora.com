FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MUSITU_STUDIO_DATA=/data
WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY studio /app/studio
COPY static /app/static
USER 10001:10001
EXPOSE 8755
# Host MUST publish this port on 127.0.0.1 only, behind a private VPN/TLS proxy.
CMD ["uvicorn","studio.web:create_app","--factory","--host","0.0.0.0","--port","8755","--no-access-log"]
